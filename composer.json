{
  "name": "samuelaguilera/facturaonline",
  "description": "Cliente PHP para consumir la API de FacturaOnline (CFDI 4.0)",
  "homepage": "https://facturaonline.com.mx",
  "type": "library",
  "require": {
    "php": "^8.1",
    "ext-json": "*",
    "guzzlehttp/guzzle": "^7.10"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.66",
    "phpstan/phpstan": "^1.12",
    "phpunit/phpunit": "^10.5"
  },
  "license": "MIT",
  "support": {
    "issues": "https://github.com/samuelaguilera/facturaonline-php/issues",
    "source": "https://github.com/samuelaguilera/facturaonline-php"
  },
  "keywords": [
    "cfdi",
    "facturacion-electronica",
    "factura-com",
    "facturaonline",
    "laravel",
    "mexico",
    "php",
    "sat"
  ],
  "autoload": {
    "psr-4": {
      "FacturaOnline\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "FacturaOnline\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit --configuration phpunit.xml.dist",
    "analyse": "phpstan analyse --configuration phpstan.neon.dist",
    "lint": "php-cs-fixer fix --config=.php-cs-fixer.dist.php --dry-run --diff",
    "format": "php-cs-fixer fix --config=.php-cs-fixer.dist.php",
    "check": [
      "@test",
      "@analyse",
      "@lint"
    ]
  },
  "authors": [
    {
      "name": "Samuel Aguilera",
      "email": "aguilera.plataforma@gmail.com"
    }
  ],
  "config": {
    "platform": {
      "php": "8.1.0"
    },
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
